{
  "name": "thomnail",
  "productName": "Thomnail",
  "version": "1.6.0",
  "description": "Video-Thumbnails als Finder-Icons – mit Tauri, Rust und React",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build && node build/licenses.mjs",
    "check": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "package": "tauri build --bundles app",
    "make": "npm run package && node build/archive.mjs",
    "tauri": "tauri"
  },
  "author": {
    "name": "TomPlaysNow",
    "email": "143933295+TomPlaysNow@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
